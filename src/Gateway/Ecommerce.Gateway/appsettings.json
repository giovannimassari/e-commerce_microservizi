{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "utenti-route": {
        "ClusterId": "utenti-cluster",
        "Match": { "Path": "/api/auth/{**catch-all}" }
      },
      "profilo-route": {
        "ClusterId": "utenti-cluster",
        "Match": { "Path": "/api/profilo/{**catch-all}" }
      },
      "magazzino-route": {
        "ClusterId": "magazzino-cluster",
        "Match": { "Path": "/api/stock/{**catch-all}" }
      },
      "ordini-route": {
        "ClusterId": "ordini-cluster",
        "Match": { "Path": "/api/ordini/{**catch-all}" }
      },
      "forniture-route": {
        "ClusterId": "approvvigionamento-cluster",
        "Match": { "Path": "/api/forniture/{**catch-all}" }
      }
    },
    "Clusters": {
      "utenti-cluster": {
        "Destinations": {
          "utenti-destination": { "Address": "http://localhost:5142" }
        }
      },
      "magazzino-cluster": {
        "Destinations": {
          "magazzino-destination": { "Address": "http://localhost:5031" }
        }
      },
      "ordini-cluster": {
        "Destinations": {
          "ordini-destination": { "Address": "http://localhost:5080" }
        }
      },
      "approvvigionamento-cluster": {
        "Destinations": {
          "approvvigionamento-destination": { "Address": "http://localhost:5093" }
        }
      }
    }
  }
}